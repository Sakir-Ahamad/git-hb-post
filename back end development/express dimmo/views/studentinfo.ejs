<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>student information</title>
</head>
<body>
    <h1>Student Information</h1>
    <p>Name: <%= name %></p>
    <p>Course: <%= course %></p>
    <p>Age: <%= age %></p>
    

   <% if (age >= 18) { %>
        <p>Status: Adult</p>
    <% } else { %>
        <p>Status: Minor</p>
    <% } %>
</body>
</html>

