<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Student List</h1>

    <table>
        <thead>
            <tr>
                <th>id</th>
                <th>name</th>
                <th>course</th>
                <th>age</th>
                <th>status</th>
            </tr>
        </thead>
    </table>

    <table>
        <tbody>
            <% students.forEach((student)) => {%
            <tr>
                <td><%= student.id %></td>
                <td><%= student.name %></td>
                <td><%= student.course %></td>
                <td><%= student.age %></td>
                <td><%= student.status %></td>
            </tr>
            }
        </tbody>
    </table>
</body>
</html>