<%- include("partials/header") %>


    <h1>Student List</h1>

    <table>
        <thead>
            <tr>
                <th>id</th>
                <th>name</th>
                <th>course</th>
                <th>age</th>
                <th>status</th>
            </tr>
        </thead>
    

    
 <tbody>
    <% students.forEach((student) => { %>
    <tr>
        <td><%= student.id %></td>
        <td><%= student.name %></td>
        <td><%= student.course %></td>
        <td><%= student.age %></td>
        
        <!-- status காலத்திற்குள் நேராக கண்டிஷனை எழுதவும் -->
        <td>
            <% if (student.age >= 18) { %>
                adult
            <% } else { %>
                minor
            <% } %>
        </td>
    </tr>
    <% }); %>
</tbody>
    </table>

<%- include("partials/footer") %>

